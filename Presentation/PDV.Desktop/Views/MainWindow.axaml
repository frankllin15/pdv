<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDV.Desktop.ViewModels"
        xmlns:views="using:PDV.Desktop.Views"
        x:Class="PDV.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PDV - Point of Sale"
        Width="1024" Height="768"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="F1" Command="{Binding NavigateToCheckoutCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding NavigateToProductsCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding NavigateToSalesHistoryCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:CheckoutViewModel">
            <views:CheckoutView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductsViewModel">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SalesHistoryViewModel">
            <views:SalesHistoryView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <!-- Navigation Menu (only visible when logged in) -->
        <Border Grid.Row="0" Background="#333" Padding="8,4" IsVisible="{Binding IsLoggedIn}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Content="Checkout (F1)"
                            Command="{Binding NavigateToCheckoutCommand}"
                            Background="{Binding IsCheckoutActive, Converter={x:Static views:MainWindow.ActiveBrushConverter}}"
                            Foreground="White"
                            Padding="16,8" />
                    <Button Content="Products (F4)"
                            Command="{Binding NavigateToProductsCommand}"
                            Background="{Binding IsProductsActive, Converter={x:Static views:MainWindow.ActiveBrushConverter}}"
                            Foreground="White"
                            Padding="16,8" />
                    <Button Content="Sales History (F6)"
                            Command="{Binding NavigateToSalesHistoryCommand}"
                            Background="{Binding IsSalesHistoryActive, Converter={x:Static views:MainWindow.ActiveBrushConverter}}"
                            Foreground="White"
                            Padding="16,8" />
                </StackPanel>

                <!-- User Info and Logout -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentOperatorName}"
                               Foreground="#BDBDBD"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <Button Content="Logout"
                            Command="{Binding LogoutCommand}"
                            Background="#555"
                            Foreground="White"
                            Padding="12,6"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
