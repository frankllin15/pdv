<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDV.Desktop.ViewModels"
        xmlns:views="using:PDV.Desktop.Views"
        xmlns:i18n="using:PDV.Desktop.I18n"
        x:Class="PDV.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{i18n:Localize Nav_Lbl_WindowTitle}"
        Width="1024" Height="768"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Home" Command="{Binding NavigateToHomeCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding NavigateToCheckoutCommand}" />
        <KeyBinding Gesture="F4" Command="{Binding NavigateToProductsCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding NavigateToSalesHistoryCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding NavigateToCloseSessionCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding OpenSupplyDialogCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding OpenBleedDialogCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:CheckoutViewModel">
            <views:CheckoutView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductsViewModel">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SalesHistoryViewModel">
            <views:SalesHistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:FiscalConfigViewModel">
            <views:FiscalConfigView />
        </DataTemplate>
        <DataTemplate DataType="vm:FiscalHistoryViewModel">
            <views:FiscalHistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:OpenSessionViewModel">
            <views:OpenSessionView />
        </DataTemplate>
        <DataTemplate DataType="vm:CloseSessionViewModel">
            <views:CloseSessionView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid ColumnDefinitions="Auto,*">
            <!-- Sidebar (Col 0) -->
            <Border Grid.Column="0" Width="220" Background="#2B2B2B"
                    IsVisible="{Binding IsSidebarVisible}">
                <Border.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#3B3B3B" />
                    </Style>
                </Border.Styles>
                <DockPanel>
                    <!-- Bottom: Settings + User Info + Logout -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="#444" Margin="8,0" />

                        <!-- Settings Group -->
                        <Button Command="{Binding ToggleSettingsExpandedCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                Foreground="White"
                                CornerRadius="4"
                                Margin="8,2"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2699;" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{i18n:Localize Nav_Btn_Settings}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="&#x25BC;" FontSize="9" VerticalAlignment="Center"
                                           Foreground="#888" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel IsVisible="{Binding IsSettingsExpanded}">
                            <Button Command="{Binding NavigateToFiscalConfigCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="{Binding IsFiscalConfigActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                    Foreground="#CCC"
                                    CornerRadius="4"
                                    Margin="24,0,8,0"
                                    Padding="16,10">
                                <TextBlock Text="{i18n:Localize Nav_Btn_FiscalConfig}" FontSize="13" />
                            </Button>

                            <!-- Language Selector -->
                            <StackPanel Margin="24,8,8,0" Spacing="4">
                                <TextBlock Text="{i18n:Localize Global_Lbl_Language}"
                                           Foreground="#888" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedIndex="{Binding SelectedLanguageIndex}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="12"
                                          Padding="8,6" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Session Indicator -->
                        <Border Margin="12,4,12,0" Padding="8,4"
                                Background="#1B5E20"
                                CornerRadius="4"
                                IsVisible="{Binding HasOpenSession}">
                            <TextBlock Text="{Binding SessionInfo}"
                                       Foreground="#A5D6A7"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <!-- User Info + Logout -->
                        <Border Margin="12,8" Padding="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CurrentOperatorName}"
                                           Foreground="#BDBDBD"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Command="{Binding LogoutCommand}"
                                        Background="#444"
                                        Foreground="White"
                                        CornerRadius="4"
                                        Padding="10,6"
                                        FontSize="12"
                                        ToolTip.Tip="{i18n:Localize Nav_Tip_Logout}">
                                    <TextBlock Text="&#x2190;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Top: Brand + Home -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Brand -->
                        <StackPanel Margin="16,16,16,4">
                            <TextBlock Text="PDV" FontSize="22" FontWeight="Bold" Foreground="#2196F3" />
                            <TextBlock Text="{i18n:Localize Nav_Lbl_PointOfSale}" FontSize="11" Foreground="#888" Margin="0,-2,0,0" />
                        </StackPanel>
                        <Border Height="1" Background="#444" Margin="8,8" />

                        <!-- Home Button -->
                        <Button Command="{Binding NavigateToHomeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{Binding IsHomeActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                Foreground="White"
                                CornerRadius="4"
                                Margin="8,2"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2302;" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{i18n:Localize Nav_Btn_Home}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Navigation Items -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">
                            <!-- Checkout Button (primary) -->
                            <Button Command="{Binding NavigateToCheckoutCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="{Binding IsCheckoutActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    CornerRadius="4"
                                    Margin="8,2"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="$" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Checkout}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#444" Margin="8,8" />

                            <!-- Cadastros Group -->
                            <Button Command="{Binding ToggleCadastrosExpandedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Foreground="White"
                                    CornerRadius="4"
                                    Margin="8,2"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#x2630;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Cadastros}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="&#x25BC;" FontSize="9" VerticalAlignment="Center"
                                               Foreground="#888" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel IsVisible="{Binding IsCadastrosExpanded}">
                                <Button Command="{Binding NavigateToProductsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{Binding IsProductsActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                        Foreground="#CCC"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Products}" FontSize="13" />
                                </Button>
                            </StackPanel>

                            <!-- Financeiro Group -->
                            <Button Command="{Binding ToggleFinanceiroExpandedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Foreground="White"
                                    CornerRadius="4"
                                    Margin="8,2"
                                    Padding="16,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="&#x2261;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Financeiro}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="&#x25BC;" FontSize="9" VerticalAlignment="Center"
                                               Foreground="#888" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel IsVisible="{Binding IsFinanceiroExpanded}">
                                <Button Command="{Binding NavigateToSalesHistoryCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{Binding IsSalesHistoryActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                        Foreground="#CCC"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_SalesHistory}" FontSize="13" />
                                </Button>
                                <Button Command="{Binding NavigateToFiscalHistoryCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="{Binding IsFiscalHistoryActive, Converter={x:Static views:MainWindow.SidebarActiveBrushConverter}}"
                                        Foreground="#CCC"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_FiscalHistory}" FontSize="13" />
                                </Button>
                                <Border Height="1" Background="#444" Margin="24,4,8,4" />
                                <Button Command="{Binding OpenSupplyDialogCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="#4CAF50"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10"
                                        IsEnabled="{Binding HasOpenSession}">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Supply}" FontSize="13" />
                                </Button>
                                <Button Command="{Binding OpenBleedDialogCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="#FF9800"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10"
                                        IsEnabled="{Binding HasOpenSession}">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_Bleed}" FontSize="13" />
                                </Button>
                                <Button Command="{Binding NavigateToCloseSessionCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="#F44336"
                                        CornerRadius="4"
                                        Margin="24,0,8,0"
                                        Padding="16,10"
                                        IsEnabled="{Binding HasOpenSession}">
                                    <TextBlock Text="{i18n:Localize Nav_Btn_CloseSession}" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content (Col 1) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- Navigation Confirmation Dialog Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding ShowNavigationConfirmDialog}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="400"
                    BoxShadow="0 8 32 0 #60000000">
                <StackPanel Spacing="20">
                    <TextBlock Text="{i18n:Localize Nav_Dlg_SaleInProgress}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{i18n:Localize Nav_Dlg_SaleInProgressMsg}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#666" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <Button Content="{i18n:Localize Global_Btn_Cancel}"
                                Command="{Binding CancelNavigationCommand}"
                                Padding="24,10"
                                Background="#E0E0E0"
                                Foreground="#333" />
                        <Button Content="{i18n:Localize Nav_Btn_LeaveAnyway}"
                                Command="{Binding ConfirmNavigationCommand}"
                                Padding="24,10"
                                Background="#F44336"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Supply Dialog Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding ShowSupplyDialog}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <ContentControl Content="{Binding SupplyViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:CashTransactionViewModel">
                        <views:CashTransactionView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- Bleed Dialog Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding ShowBleedDialog}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <ContentControl Content="{Binding BleedViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:CashTransactionViewModel">
                        <views:CashTransactionView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Panel>
</Window>
