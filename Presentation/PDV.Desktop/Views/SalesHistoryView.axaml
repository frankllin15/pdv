<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:conv="using:PDV.Desktop.Converters"
             x:Class="PDV.Desktop.Views.SalesHistoryView"
             x:DataType="vm:SalesHistoryViewModel"
             Background="#F0F0F0">

    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding SearchCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearDetailCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF5722" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Sales History"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="View and analyze past sales"
                               FontSize="14" Foreground="White" Opacity="0.9" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Background="White" Padding="16" Margin="16,16,16,0"
                CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <!-- Date Range -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Start Date" Margin="0,0,0,4" FontSize="12" Foreground="#666" />
                    <DatePicker SelectedDate="{Binding StartDate}" Width="140" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="End Date" Margin="0,0,0,4" FontSize="12" Foreground="#666" />
                    <DatePicker SelectedDate="{Binding EndDate}" Width="140" />
                </StackPanel>

                <!-- Quick Filters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4" Margin="0,0,16,0">
                    <Button Content="Today" Command="{Binding SetTodayCommand}" Padding="8,6" />
                    <Button Content="This Week" Command="{Binding SetThisWeekCommand}" Padding="8,6" />
                    <Button Content="This Month" Command="{Binding SetThisMonthCommand}" Padding="8,6" />
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Status" Margin="0,0,0,4" FontSize="12" Foreground="#666" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding SelectedStatus}"
                              SelectedValueBinding="{Binding Value}"
                              DisplayMemberBinding="{Binding Label}"
                              Width="120" />
                </StackPanel>

                <!-- Search Button -->
                <Button Grid.Column="5" Content="Search (F5)"
                        Command="{Binding SearchCommand}"
                        Background="#FF5722"
                        Foreground="White"
                        Padding="24,8"
                        FontWeight="SemiBold"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="16" ColumnDefinitions="*,400">
            <!-- Sales Grid -->
            <Border Background="White" CornerRadius="8" Padding="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Summary Cards -->
                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,8">
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="12" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Total Sales" FontSize="11" Foreground="#666" />
                                <TextBlock Text="{Binding TotalSales}" FontSize="20" FontWeight="Bold" Foreground="#1976D2" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="4" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Revenue" FontSize="11" Foreground="#666" />
                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:C}'}" FontSize="20" FontWeight="Bold" Foreground="#388E3C" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="4" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Avg Ticket" FontSize="11" Foreground="#666" />
                                <TextBlock Text="{Binding AverageTicket, StringFormat='{}{0:C}'}" FontSize="20" FontWeight="Bold" Foreground="#F57C00" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#E8F5E9" CornerRadius="4" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Completed" FontSize="11" Foreground="#666" />
                                <TextBlock Text="{Binding CompletedSales}" FontSize="20" FontWeight="Bold" Foreground="#388E3C" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#FFEBEE" CornerRadius="4" Padding="12" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Cancelled" FontSize="11" Foreground="#666" />
                                <TextBlock Text="{Binding CancelledSales}" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Sales}"
                              SelectedItem="{Binding SelectedSale}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SaleNumber}" Width="70" />
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="100" />
                            <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="60" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerDocument}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sale Detail Panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    Padding="16" Margin="16,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Panel>
                    <!-- When no sale selected -->
                    <StackPanel IsVisible="{Binding SaleDetail, Converter={x:Static ObjectConverters.IsNull}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select a sale to view details"
                                   Foreground="#999" FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Sale Detail -->
                    <ScrollViewer IsVisible="{Binding SaleDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel DataContext="{Binding SaleDetail}" Spacing="12">
                            <!-- Header -->
                            <StackPanel>
                                <TextBlock Text="{Binding SaleNumber, StringFormat='Sale #{0}'}"
                                           FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding SaleDate, StringFormat='{}{0:dddd, dd MMMM yyyy HH:mm}'}"
                                           Foreground="#666" />
                            </StackPanel>

                            <Separator />

                            <!-- Items -->
                            <TextBlock Text="Items" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                                    <TextBlock Foreground="#666" FontSize="12">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} x {1:C}">
                                                                <Binding Path="Quantity" />
                                                                <Binding Path="UnitPrice" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C}'}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator />

                            <!-- Totals -->
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <TextBlock Text="Subtotal" Foreground="#666" />
                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:C}'}" />

                                <TextBlock Grid.Row="1" Text="Discount" Foreground="#666" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount, StringFormat='-{0:C}'}"
                                           Foreground="#4CAF50" Margin="0,4,0,0" />

                                <TextBlock Grid.Row="2" Text="TOTAL" FontWeight="Bold" FontSize="16" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C}'}"
                                           FontWeight="Bold" FontSize="16" Foreground="#FF5722" Margin="0,8,0,0" />
                            </Grid>

                            <Separator />

                            <!-- Payments -->
                            <TextBlock Text="Payments" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding MethodText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AuthorizationCode}" Foreground="#666" FontSize="11"
                                                           IsVisible="{Binding AuthorizationCode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:C}'}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="16,8"
                Background="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FFEBEE|#E8F5E9'}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}" />
        </Border>
    </Grid>
</UserControl>
