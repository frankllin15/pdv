<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:conv="using:PDV.Desktop.Converters"
             x:Class="PDV.Desktop.Views.FiscalConfigView"
             x:DataType="vm:FiscalConfigViewModel"
             Background="#F0F0F0"
             Loaded="OnLoaded">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#673AB7" Padding="16">
            <StackPanel>
                <TextBlock Text="Configuracao Fiscal"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="Configurar dados para emissao de NFC-e"
                           FontSize="14" Foreground="White" Opacity="0.9" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="16">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="16">

                <!-- Company Data Section -->
                <Border Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Dados da Empresa" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#673AB7" Margin="0,0,0,8" />

                        <!-- CNPJ and IE -->
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CNPJ *" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TaxId}"
                                         Watermark="00.000.000/0000-00"
                                         Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Inscricao Estadual" Margin="0,0,0,4" />
                                <TextBox Text="{Binding StateRegistration}" Height="40" />
                            </StackPanel>
                        </Grid>

                        <!-- Legal Name -->
                        <StackPanel>
                            <TextBlock Text="Razao Social *" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LegalName}" Height="40" />
                        </StackPanel>

                        <!-- Trade Name -->
                        <StackPanel>
                            <TextBlock Text="Nome Fantasia *" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TradeName}" Height="40" />
                        </StackPanel>

                        <!-- State and Tax Regime -->
                        <Grid ColumnDefinitions="*,16,2*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="UF *" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding StateOptions}"
                                          SelectedItem="{Binding State}"
                                          Height="40"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Regime Tributario *" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding TaxRegimeOptions}"
                                          SelectedValue="{Binding TaxRegime}"
                                          SelectedValueBinding="{Binding Value}"
                                          DisplayMemberBinding="{Binding Description}"
                                          Height="40"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Address Section -->
                <Border Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Endereco" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#673AB7" Margin="0,0,0,8" />

                        <!-- Address and Number -->
                        <Grid ColumnDefinitions="2*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Logradouro *" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Address}" Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Numero *" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AddressNumber}" Height="40" />
                            </StackPanel>
                        </Grid>

                        <!-- Neighborhood and ZipCode -->
                        <Grid ColumnDefinitions="2*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bairro" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Neighborhood}" Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CEP *" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ZipCode}"
                                         Watermark="00000-000"
                                         Height="40" />
                            </StackPanel>
                        </Grid>

                        <!-- City Code -->
                        <StackPanel>
                            <TextBlock Text="Codigo IBGE do Municipio * (7 digitos)" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CityCode}"
                                     Watermark="3550308"
                                     MaxWidth="200"
                                     HorizontalAlignment="Left"
                                     Height="40" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- NFC-e Parameters Section -->
                <Border Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Parametros NFC-e" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#673AB7" Margin="0,0,0,8" />

                        <!-- Series and Next Number -->
                        <Grid ColumnDefinitions="*,16,*,16,2*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Serie *" Margin="0,0,0,4" />
                                <NumericUpDown Value="{Binding Series}"
                                               Minimum="1" Maximum="999"
                                               Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Proximo Numero" Margin="0,0,0,4" />
                                <NumericUpDown Value="{Binding NextNumber}"
                                               Minimum="1"
                                               Height="40"
                                               IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ambiente" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                                    <RadioButton Content="Homologacao (Teste)"
                                                 IsChecked="{Binding !IsProduction}"
                                                 GroupName="Ambiente" />
                                    <RadioButton Content="Producao"
                                                 IsChecked="{Binding IsProduction}"
                                                 GroupName="Ambiente" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- CSC -->
                        <Grid ColumnDefinitions="*,16,2*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CSC ID" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CscId}" Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CSC Token" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CscToken}" Height="40" />
                            </StackPanel>
                        </Grid>

                        <!-- Certificate -->
                        <Grid ColumnDefinitions="2*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Caminho do Certificado Digital (A1)" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CertificatePath}"
                                         Watermark="C:\certificados\certificado.pfx"
                                         Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Senha do Certificado" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CertificatePassword}"
                                         PasswordChar="*"
                                         Height="40" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Border Background="White" CornerRadius="8" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="Testar Conexao SEFAZ"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsTesting}"
                                Background="#2196F3"
                                Foreground="White"
                                Height="44" Padding="24,0" />
                        <Button Content="Salvar Configuracao"
                                Command="{Binding SaveConfigCommand}"
                                IsEnabled="{Binding !IsSaving}"
                                Background="#673AB7"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Height="44" Padding="24,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="16,8"
                Background="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FFEBEE|#E8F5E9'}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}" />
        </Border>
    </Grid>
</UserControl>
