<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:conv="using:PDV.Desktop.Converters"
             x:Class="PDV.Desktop.Views.ReceiptPreviewView"
             x:DataType="vm:ReceiptPreviewViewModel"
             Width="500"
             Loaded="OnLoaded">

    <Border Background="White" CornerRadius="8" Padding="0"
            BorderBrush="#E0E0E0" BorderThickness="1"
            BoxShadow="0 8 32 0 #40000000">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- Header -->
            <Border Grid.Row="0" Background="#673AB7" Padding="16" CornerRadius="8,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="White" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SaleNumber, StringFormat='Venda #{0}'}"
                                       Foreground="White" Opacity="0.9" FontSize="13" />
                            <TextBlock Text="{Binding Total, StringFormat='Total: R$ {0:N2}'}"
                                       Foreground="White" Opacity="0.9" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border Grid.Column="1" CornerRadius="4" Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{Binding IsContingency, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FF9800|#4CAF50'}">
                        <TextBlock Text="{Binding IsContingency, Converter={x:Static conv:BoolToStringConverter.Instance}, ConverterParameter='Contingencia|Autorizada'}"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Receipt Preview -->
            <Border Grid.Row="1" Background="#F5F5F5" Margin="16" Padding="0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="400">
                    <TextBlock Text="{Binding ReceiptContent}"
                               FontFamily="Consolas, Courier New, monospace"
                               FontSize="11"
                               Padding="12"
                               Background="White"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>

            <!-- Printer Selection -->
            <Border Grid.Row="2" Padding="16,0,16,16">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Impressora:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="#666" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePrinters}"
                              SelectedItem="{Binding SelectedPrinter}"
                              HorizontalAlignment="Stretch"
                              IsEnabled="{Binding !IsPrinting}" />
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Grid.Row="3" Background="#F5F5F5" Padding="16" CornerRadius="0,0,8,8">
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Status Message -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding StatusMessage}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}"
                               FontSize="13"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center" />

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Salvar Arquivo"
                                Command="{Binding SaveToFileCommand}"
                                IsEnabled="{Binding !IsPrinting}"
                                Background="#E0E0E0"
                                Foreground="#333"
                                Padding="16,10" />
                        <Button Content="Fechar"
                                Command="{Binding CloseCommand}"
                                IsEnabled="{Binding !IsPrinting}"
                                Background="#757575"
                                Foreground="White"
                                Padding="16,10" />
                        <Button Content="Imprimir"
                                Command="{Binding PrintCommand}"
                                IsEnabled="{Binding !IsPrinting}"
                                Background="#2196F3"
                                Foreground="White"
                                Padding="16,10" />
                        <Button Content="Imprimir e Fechar"
                                Command="{Binding PrintAndCloseCommand}"
                                IsEnabled="{Binding !IsPrinting}"
                                Background="#673AB7"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="16,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
