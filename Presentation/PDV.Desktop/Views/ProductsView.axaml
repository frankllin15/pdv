<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:conv="using:PDV.Desktop.Converters"
             x:Class="PDV.Desktop.Views.ProductsView"
             x:DataType="vm:ProductsViewModel"
             Background="#F0F0F0">

    <UserControl.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding LoadProductsCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProductCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#673AB7" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Product Management"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Add, edit and manage products"
                               FontSize="14" Foreground="White" Opacity="0.9" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="+ New Product (Ctrl+N)"
                        Command="{Binding NewProductCommand}"
                        Background="#9C27B0"
                        Foreground="White"
                        Padding="16,8"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Panel Grid.Row="1" Margin="16">
            <!-- List Mode -->
            <Grid ColumnDefinitions="*,350" IsVisible="{Binding !IsEditing}">
                <!-- Product List -->
                <Border Background="White" CornerRadius="8" Padding="8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Search -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                            <TextBox Text="{Binding SearchText}"
                                     Watermark="Search by barcode or description..."
                                     FontSize="14"
                                     Height="40">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Search"
                                    Command="{Binding SearchCommand}"
                                    Margin="8,0,0,0"
                                    Height="40" Width="80" />
                            <Button Grid.Column="2" Content="Refresh (F5)"
                                    Command="{Binding LoadProductsCommand}"
                                    Margin="8,0,0,0"
                                    Height="40" />
                        </Grid>

                        <!-- Products DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="100" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat='{}{0:N2}'}" Width="80" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="60" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="Edit"
                                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).EditProductCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#2196F3"
                                                        Foreground="White"
                                                        Padding="8,4" />
                                                <Button Content="Del"
                                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).DeleteProductCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#FF5252"
                                                        Foreground="White"
                                                        Padding="8,4" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Quick Stock Adjustment Panel -->
                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8"
                        Padding="16" Margin="16,0,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Quick Stock Adjustment" FontWeight="SemiBold" FontSize="16"
                                   Margin="0,0,0,16" />

                        <StackPanel IsVisible="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding SelectedProduct.Description}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedProduct.Barcode}" Foreground="#666"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="Current Stock:" Foreground="#666" />
                            <TextBlock Text="{Binding SelectedProduct.StockQuantity, StringFormat='{}{0:N2}'}"
                                       FontSize="24" FontWeight="Bold" Foreground="#673AB7"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="Adjustment (+/-):" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedProduct.StockAdjustment}"
                                     FontSize="16" Height="40"
                                     Margin="0,0,0,8" />

                            <Button Content="Apply Adjustment"
                                    Command="{Binding AdjustStockCommand}"
                                    CommandParameter="{Binding SelectedProduct}"
                                    Background="#673AB7"
                                    Foreground="White"
                                    Height="40"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock Text="Select a product to adjust stock"
                                   Foreground="#999"
                                   IsVisible="{Binding SelectedProduct, Converter={x:Static ObjectConverters.IsNull}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Edit Mode -->
            <Border Background="White" CornerRadius="8" Padding="24"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    IsVisible="{Binding IsEditing}"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding IsNewProduct, Converter={x:Static conv:BoolToStringConverter.Instance}, ConverterParameter='New Product|Edit Product'}"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

                    <!-- Barcode and Unit -->
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Barcode *" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.Barcode}" Height="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit of Measure" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.UnitOfMeasure}" Height="40" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <StackPanel>
                        <TextBlock Text="Description *" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditingProduct.Description}" Height="40" />
                    </StackPanel>

                    <!-- Short Description -->
                    <StackPanel>
                        <TextBlock Text="Short Description (for receipt)" Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditingProduct.ShortDescription}" Height="40" />
                    </StackPanel>

                    <!-- Price and Stock -->
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Unit Price *" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.UnitPrice}" Height="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock Quantity" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.StockQuantity}" Height="40" />
                        </StackPanel>
                    </Grid>

                    <!-- Tax Code and Rate -->
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tax Code (NCM)" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.TaxCode}" Height="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tax Rate % (ICMS)" Margin="0,0,0,4" />
                            <TextBox Text="{Binding EditingProduct.TaxRate}" Height="40" />
                        </StackPanel>
                    </Grid>

                    <!-- Active -->
                    <CheckBox IsChecked="{Binding EditingProduct.IsActive}" Content="Product is Active" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Cancel (Esc)"
                                Command="{Binding CancelEditCommand}"
                                Height="40" Width="120" />
                        <Button Content="Save Product"
                                Command="{Binding SaveProductCommand}"
                                Background="#673AB7"
                                Foreground="White"
                                Height="40" Width="120"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="16,8"
                Background="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FFEBEE|#E8F5E9'}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}" />
        </Border>
    </Grid>
</UserControl>
