<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:i18n="using:PDV.Desktop.I18n"
             x:Class="PDV.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearPinCommand}" />
    </UserControl.KeyBindings>

    <Grid Background="#F0F0F0">
        <!-- Centered Login Panel -->
        <Border Background="White"
                CornerRadius="12"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="400"
                BoxShadow="0 4 20 0 #40000000">
            <StackPanel Spacing="24">
                <!-- Logo/Title -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="{i18n:Localize Login_Lbl_Title}"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="#2196F3"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{i18n:Localize Login_Lbl_Subtitle}"
                               FontSize="14"
                               Foreground="#757575"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Login Form -->
                <StackPanel Spacing="16">
                    <!-- Operator Code -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Localize Login_Lbl_OperatorCode}"
                                   FontSize="14"
                                   Foreground="#424242" />
                        <TextBox Text="{Binding OperatorCode}"
                                 FontSize="18"
                                 Height="48"
                                 Watermark="{i18n:Localize Login_Wm_OperatorCode}"
                                 IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- PIN -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{i18n:Localize Login_Lbl_Pin}"
                                   FontSize="14"
                                   Foreground="#424242" />
                        <TextBox Text="{Binding Pin}"
                                 FontSize="18"
                                 Height="48"
                                 PasswordChar="*"
                                 Watermark="{i18n:Localize Login_Wm_Pin}"
                                 IsEnabled="{Binding !IsLoading}" />
                    </StackPanel>

                    <!-- Error Message -->
                    <Border Background="#FFEBEE"
                            CornerRadius="4"
                            Padding="12"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C62828"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Background="#2196F3"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalContentAlignment="Center">
                        <Panel>
                            <TextBlock Text="{i18n:Localize Login_Btn_Login}"
                                       IsVisible="{Binding !IsLoading}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding IsLoading}"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{i18n:Localize Login_Msg_Authenticating}" />
                            </StackPanel>
                        </Panel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Text="{i18n:Localize Login_Msg_Footer}"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Version Info -->
        <TextBlock Text="v1.0.0"
                   FontSize="11"
                   Foreground="#BDBDBD"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="16" />
    </Grid>
</UserControl>
