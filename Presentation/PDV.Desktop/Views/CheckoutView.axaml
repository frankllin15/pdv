<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDV.Desktop.ViewModels"
             xmlns:conv="using:PDV.Desktop.Converters"
             xmlns:dto="using:PDV.Shared.DTOs"
             xmlns:i18n="using:PDV.Desktop.I18n"
             x:Class="PDV.Desktop.Views.CheckoutView"
             x:DataType="vm:CheckoutViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F2" Command="{Binding ProcessPaymentCommand}" CommandParameter="Cash" />
        <KeyBinding Gesture="F3" Command="{Binding EnterPaymentModeCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding OpenProductSearchCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding RequestCancelSaleCommand}" />
        <KeyBinding Gesture="F12" Command="{Binding RequestNewSaleCommand}" />
    </UserControl.KeyBindings>

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateBackFromCheckoutCommand}"
                        Background="#1976D2" Foreground="White"
                        Padding="12,8" CornerRadius="4"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        ToolTip.Tip="{i18n:Localize PDV_Tip_BackToMenu}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#x2190;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{i18n:Localize PDV_Btn_Menu}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{i18n:Localize PDV_Lbl_Title}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="{Binding SaleInfoHeader}"
                               FontSize="14" Foreground="White" Opacity="0.9" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding Total, StringFormat='{}{0:C}'}"
                           FontSize="36" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="16">
            <!-- Items Grid -->
            <Border Background="White" CornerRadius="8" Padding="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <!-- Barcode Input -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBox Text="{Binding BarcodeInput}"
                                 Watermark="{i18n:Localize PDV_Wm_Barcode}"
                                 FontSize="16"
                                 Height="44"
                                 IsEnabled="{Binding !IsPaymentMode}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchProductCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="{i18n:Localize PDV_Btn_Add}"
                                Command="{Binding SearchProductCommand}"
                                Margin="8,0,0,0"
                                Height="44" Width="80"
                                IsEnabled="{Binding !IsPaymentMode}" />
                        <Button Grid.Column="2" Content="{i18n:Localize PDV_Btn_Search}"
                                Command="{Binding OpenProductSearchCommand}"
                                Margin="8,0,0,0"
                                Height="44"
                                Background="#9C27B0"
                                Foreground="White"
                                IsEnabled="{Binding !IsPaymentMode}" />
                    </Grid>

                    <!-- Items DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="ItemsDataGrid"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Seq}" Binding="{Binding Sequence}" Width="50" IsReadOnly="True" />
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Barcode}" Binding="{Binding Barcode}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Description}" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Qty}" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="70" />
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Price}" Binding="{Binding UnitPrice, StringFormat='{}{0:C}'}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="{i18n:Localize PDV_Col_Total}" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="100" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding $parent[DataGrid].((vm:CheckoutViewModel)DataContext).RemoveSelectedItemCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#FF5252"
                                                Foreground="White"
                                                Width="30" Height="26"
                                                HorizontalContentAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel - Payment -->
            <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8"
                    Padding="16" Margin="16,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{i18n:Localize PDV_Lbl_OrderSummary}" FontWeight="SemiBold" FontSize="16"
                               Margin="0,0,0,16" />

                    <!-- Totals -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{i18n:Localize PDV_Lbl_Subtotal}" Grid.Row="0" Foreground="#666" />
                        <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:C}'}"
                                   Grid.Row="0" Grid.Column="1"
                                   HorizontalAlignment="Right" />

                        <TextBlock Text="{i18n:Localize PDV_Lbl_Discount}" Grid.Row="1" Foreground="#666" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Discount, StringFormat='-{0:C}'}"
                                   Grid.Row="1" Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Foreground="#4CAF50" Margin="0,4,0,0" />

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8" />

                        <TextBlock Text="{i18n:Localize PDV_Lbl_Total}" Grid.Row="3" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="{Binding Total, StringFormat='{}{0:C}'}"
                                   Grid.Row="3" Grid.Column="1"
                                   FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Right"
                                   Foreground="#2196F3" />
                    </Grid>

                    <!-- Cash Amount Input (visible when paying with cash) -->
                    <StackPanel IsVisible="{Binding IsPaymentMode}" Margin="0,0,0,8">
                        <TextBlock Text="{i18n:Localize PDV_Lbl_AmountReceived}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="AmountReceivedInput"
                                 Text="{Binding AmountReceivedText}"
                                 Watermark="{i18n:Localize PDV_Wm_AmountReceived}"
                                 FontSize="20"
                                 Height="48"
                                 Margin="0,0,0,8">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ProcessPaymentCommand}" CommandParameter="Cash" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="{i18n:Localize PDV_Btn_ConfirmCash}"
                                Command="{Binding ProcessPaymentCommand}"
                                CommandParameter="Cash"
                                Height="44"
                                HorizontalAlignment="Stretch"
                                Background="#4CAF50"
                                Foreground="White"
                                FontSize="14" FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Payment Buttons -->
                    <StackPanel Spacing="8">
                        <Button Content="{i18n:Localize PDV_Btn_Cash}"
                                Command="{Binding ProcessPaymentCommand}"
                                CommandParameter="Cash"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Background="#4CAF50"
                                Foreground="White"
                                FontSize="14" FontWeight="SemiBold"
                                IsEnabled="{Binding ItemCount}" />

                        <Button Content="{i18n:Localize PDV_Btn_CreditCard}"
                                Command="{Binding ProcessPaymentCommand}"
                                CommandParameter="CreditCard"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#2196F3"
                                Foreground="White"
                                IsEnabled="{Binding ItemCount}" />

                        <Button Content="{i18n:Localize PDV_Btn_DebitCard}"
                                Command="{Binding ProcessPaymentCommand}"
                                CommandParameter="DebitCard"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#03A9F4"
                                Foreground="White"
                                IsEnabled="{Binding ItemCount}" />

                        <Button Content="{i18n:Localize PDV_Btn_Pix}"
                                Command="{Binding ProcessPaymentCommand}"
                                CommandParameter="Pix"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#00BFA5"
                                Foreground="White"
                                IsEnabled="{Binding ItemCount}" />

                        <Separator Margin="0,8" />

                        <Button Content="{i18n:Localize PDV_Btn_CancelSale}"
                                Command="{Binding RequestCancelSaleCommand}"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#FF5252"
                                Foreground="White" />

                        <Button Content="{i18n:Localize PDV_Btn_NewSale}"
                                Command="{Binding RequestNewSaleCommand}"
                                Height="40"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="16,8"
                Background="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FFEBEE|#E8F5E9'}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}" />
        </Border>

        <!-- Keyboard Shortcuts Info -->
        <Border Grid.Row="2" Background="#FAFAFA" Padding="16,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="{i18n:Localize PDV_Lbl_Shortcuts}"
                       Foreground="#757575" FontSize="12"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>

    <!-- Pending Sales Dialog Overlay -->
    <Border IsVisible="{Binding ShowPendingSalesDialog}"
            Background="#80000000">
        <Border Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="500" MaxWidth="600" MaxHeight="500"
                Padding="24" Margin="32">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="{i18n:Localize PDV_Dlg_PendingSalesTitle}"
                           FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="1"
                           Text="{i18n:Localize PDV_Dlg_PendingSalesMsg}"
                           Foreground="#666"
                           Margin="0,0,0,16" />

                <!-- Pending Sales List -->
                <Border Grid.Row="2"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Margin="0,0,0,16">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PendingSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:PendingSaleSummaryDto">
                                    <Border Background="White" CornerRadius="4"
                                            BorderBrush="#E0E0E0" BorderThickness="1"
                                            Padding="12" Margin="8,8,8,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Sale #{0} - {1:C}">
                                                            <Binding Path="SaleNumber" />
                                                            <Binding Path="Total" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Foreground="#666" FontSize="12">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} items | {1:hh\:mm} ago">
                                                            <Binding Path="ItemCount" />
                                                            <Binding Path="Age" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="{i18n:Localize PDV_Btn_Resume}"
                                                    Command="{Binding $parent[ItemsControl].((vm:CheckoutViewModel)DataContext).ResumeSaleCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2196F3"
                                                    Foreground="White"
                                                    Padding="16,8"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <Button Content="{i18n:Localize PDV_Btn_DiscardAll}"
                            Command="{Binding DiscardPendingSalesCommand}"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Background="#FF5252"
                            Foreground="White"
                            HorizontalContentAlignment="Center" />

                    <Button Content="{i18n:Localize PDV_Btn_StartNewKeep}"
                            Command="{Binding StartNewKeepPendingCommand}"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>

    <!-- Cancel Sale Confirmation Dialog -->
    <Border IsVisible="{Binding ShowCancelConfirmDialog}"
            Background="#80000000">
        <Border Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="350" MaxWidth="400"
                Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="{i18n:Localize PDV_Dlg_CancelSaleTitle}"
                           FontSize="20" FontWeight="Bold" />

                <TextBlock Text="{i18n:Localize PDV_Dlg_CancelSaleMsg}"
                           TextWrapping="Wrap"
                           Foreground="#666" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{i18n:Localize PDV_Btn_NoKeepSale}"
                            Command="{Binding DismissCancelDialogCommand}"
                            Padding="16,8" />

                    <Button Content="{i18n:Localize PDV_Btn_YesCancelSale}"
                            Command="{Binding ConfirmCancelSaleCommand}"
                            Background="#FF5252"
                            Foreground="White"
                            Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- New Sale Confirmation Dialog -->
    <Border IsVisible="{Binding ShowNewSaleConfirmDialog}"
            Background="#80000000">
        <Border Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="350" MaxWidth="400"
                Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="{i18n:Localize PDV_Dlg_NewSaleTitle}"
                           FontSize="20" FontWeight="Bold" />

                <TextBlock Text="{i18n:Localize PDV_Dlg_NewSaleMsg}"
                           TextWrapping="Wrap"
                           Foreground="#666" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{i18n:Localize PDV_Btn_NoKeepCurrent}"
                            Command="{Binding DismissNewSaleDialogCommand}"
                            Padding="16,8" />

                    <Button Content="{i18n:Localize PDV_Btn_YesStartNew}"
                            Command="{Binding ConfirmNewSaleCommand}"
                            Background="#2196F3"
                            Foreground="White"
                            Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Product Search Dialog -->
    <Border IsVisible="{Binding ShowProductSearch}"
            Background="#80000000">
        <Border Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" Height="550"
                Padding="24">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{i18n:Localize PDV_Search_Title}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding ProductSearchPagination.TotalCount, StringFormat='{}{0} product(s) found'}"
                                   Foreground="#666" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="X"
                            Command="{Binding CloseProductSearchCommand}"
                            Background="Transparent"
                            Foreground="#666"
                            FontSize="18"
                            Padding="8,4" />
                </Grid>

                <!-- Search Input -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBox Text="{Binding ProductSearchText}"
                             Watermark="{i18n:Localize PDV_Search_Watermark}"
                             FontSize="16"
                             Height="44">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchProductsByDescriptionCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="{i18n:Localize Global_Btn_Search}"
                            Command="{Binding SearchProductsByDescriptionCommand}"
                            Margin="8,0,0,0"
                            Height="44"
                            Background="#2196F3"
                            Foreground="White"
                            Padding="16,0" />
                </Grid>

                <!-- Results List -->
                <Border Grid.Row="2"
                        Background="#F5F5F5" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Panel>
                        <!-- Loading Indicator -->
                        <TextBlock Text="{i18n:Localize Global_Lbl_Loading}"
                                   IsVisible="{Binding IsSearching}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666" />

                        <!-- Empty State -->
                        <TextBlock Text="{i18n:Localize PDV_Search_NoResults}"
                                   IsVisible="{Binding !ProductSearchResults.Count}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#999"
                                   FontSize="13" />

                        <!-- Results -->
                        <ScrollViewer IsVisible="{Binding ProductSearchResults.Count}">
                            <ItemsControl ItemsSource="{Binding ProductSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ProductDto">
                                        <Button Command="{Binding $parent[ItemsControl].((vm:CheckoutViewModel)DataContext).AddProductFromSearchCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Padding="0"
                                                Margin="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Border Background="White"
                                                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{i18n:Localize PDV_Search_CodeLabel}" Foreground="#666" FontSize="12" />
                                                                <TextBlock Text="{Binding Barcode}" Foreground="#666" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{i18n:Localize PDV_Search_StockLabel}" Foreground="#666" FontSize="12" />
                                                                <TextBlock Text="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Foreground="#666" FontSize="12" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding UnitPrice, StringFormat='{}{0:C}'}"
                                                               FontSize="16" FontWeight="Bold"
                                                               Foreground="#4CAF50"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Border>

                <!-- Pagination -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0"
                      IsVisible="{Binding ProductSearchResults.Count}">
                    <Button Grid.Column="0"
                            Content="{i18n:Localize Global_Btn_Previous}"
                            Command="{Binding ProductSearchPagination.PreviousPageCommand}"
                            IsEnabled="{Binding ProductSearchPagination.HasPreviousPage}"
                            Background="Transparent"
                            Foreground="#2196F3"
                            Padding="8,6" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProductSearchPagination.PageInfo}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666" FontSize="13" />
                    <Button Grid.Column="2"
                            Content="{i18n:Localize Global_Btn_Next}"
                            Command="{Binding ProductSearchPagination.NextPageCommand}"
                            IsEnabled="{Binding ProductSearchPagination.HasNextPage}"
                            Background="Transparent"
                            Foreground="#2196F3"
                            Padding="8,6" />
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="4"
                           Text="{i18n:Localize PDV_Search_ClickToAdd}"
                           Foreground="#666" FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Border>

    <!-- Receipt Preview Dialog -->
    <Border IsVisible="{Binding ShowReceiptPreview}"
            Background="#80000000">
        <Border Background="White" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="520" MaxHeight="650"
                BoxShadow="0 8 32 0 #40000000">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Border Grid.Row="0" Background="#673AB7" Padding="16" CornerRadius="8,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{i18n:Localize PDV_Receipt_Title}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="White" />
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ReceiptSaleNumberDisplay}"
                                           Foreground="White" Opacity="0.9" FontSize="13" />
                                <TextBlock Text="{Binding ReceiptNfceDisplay}"
                                           Foreground="White" Opacity="0.9" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="4" Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{Binding ReceiptIsContingency, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#FF9800|#4CAF50'}">
                            <Panel>
                                <TextBlock Text="{i18n:Localize PDV_Receipt_Contingency}" IsVisible="{Binding ReceiptIsContingency}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{i18n:Localize PDV_Receipt_Authorized}" IsVisible="{Binding !ReceiptIsContingency}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Panel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Receipt Content -->
                <Border Grid.Row="1" Background="#F5F5F5" Margin="16" Padding="0"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="380">
                        <TextBlock Text="{Binding ReceiptContent}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="10"
                                   Padding="12"
                                   Background="White"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>

                <!-- Actions -->
                <Border Grid.Row="2" Background="#F5F5F5" Padding="16" CornerRadius="0,0,8,8">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Status -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding StatusMessage}"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding IsError, Converter={x:Static conv:BoolToBrushConverter.Instance}, ConverterParameter='#C62828|#2E7D32'}"
                                   FontSize="13"
                                   Margin="0,0,0,12"
                                   HorizontalAlignment="Center" />

                        <!-- Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{i18n:Localize PDV_Receipt_BtnSave}"
                                    Command="{Binding SaveReceiptToFileCommand}"
                                    Background="#E0E0E0"
                                    Foreground="#333"
                                    Padding="16,10" />
                            <Button Content="{i18n:Localize Global_Btn_Close}"
                                    Command="{Binding CloseReceiptPreviewCommand}"
                                    Background="#757575"
                                    Foreground="White"
                                    Padding="16,10" />
                            <Button Content="{i18n:Localize Global_Btn_Print}"
                                    Command="{Binding PrintReceiptCommand}"
                                    Background="#2196F3"
                                    Foreground="White"
                                    Padding="16,10" />
                            <Button Content="{i18n:Localize PDV_Receipt_BtnPrintAndClose}"
                                    Command="{Binding PrintReceiptAndCloseCommand}"
                                    Background="#673AB7"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="16,10" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>

    <!-- Change (Troco) Dialog Overlay -->
    <Border IsVisible="{Binding ShowChangeDialog}"
            Background="#CC000000">
        <Border Background="White" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="420" MaxWidth="480"
                Padding="32"
                BoxShadow="0 8 32 0 #60000000">
            <Border.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding DismissChangeDialogCommand}" />
            </Border.KeyBindings>
            <StackPanel Spacing="16">
                <!-- Title -->
                <TextBlock Text="{i18n:Localize PDV_Dlg_ChangeTitle}"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#333" />

                <!-- Sale Total -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{i18n:Localize PDV_Dlg_SaleTotal}"
                               FontSize="16" Foreground="#666"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Total, StringFormat='{}{0:C}'}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#333" />
                </Grid>

                <!-- Amount Received -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{i18n:Localize PDV_Dlg_AmountReceived}"
                               FontSize="16" Foreground="#666"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding AmountPaid, StringFormat='{}{0:C}'}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#333" />
                </Grid>

                <Separator Margin="0,4" />

                <!-- Change Value - Big and prominent -->
                <Border Background="#E8F5E9" CornerRadius="8" Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{i18n:Localize PDV_Dlg_ChangeValue}"
                                   FontSize="16" Foreground="#2E7D32"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Change, StringFormat='{}{0:C}'}"
                                   FontSize="48" FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Confirm Button -->
                <Button Content="{i18n:Localize PDV_Btn_ConfirmChange}"
                        Command="{Binding DismissChangeDialogCommand}"
                        Height="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#4CAF50"
                        Foreground="White"
                        FontSize="16" FontWeight="SemiBold"
                        Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
